#!/usr/bin/env bash
# supervisor-bootstrap — one-time setup for an AUTHENTICATED supervisor on a box.
#
# SUPERSEDED by `supervisor bootstrap` (v0.3.0+), which generates the cert natively
# (no openssl) and can't drift from the CLI's flags. This script is kept for use with
# pre-v0.3.0 binaries. Prefer the subcommand when your `supervisor` has it.
#
# Generates a self-signed server TLS cert+key, then emits (a) the exact `supervisor
# spawn` invocation and (b) a systemd unit that runs the supervisor with TLS + an
# ed25519 authorized-keys allowlist. Hand the generated server-cert.pem to each client
# so they can pin it in their ~/.config/supervisor/config profile.
#
# The supervisor process IS the host for the supervised tree (no separate theater daemon);
# a `systemctl restart` hard-kills + respawns the whole tree (see docs/remote-management.md
# + the SIGTERM note). Point any watchdog at THIS unit.
#
# Usage:
#   supervisor-bootstrap \
#       --out /etc/supervisor \
#       --host mail.example.com \
#       --roster /etc/supervisor/roster.json \
#       --authorized-key <inbox-dev-pubkey-hex> \
#       --authorized-key <manager-pubkey-hex> \
#       --authorized-key <operator-pubkey-hex> \
#       [--port 9000] [--bind 0.0.0.0] [--ip <listen-ip>] \
#       [--unit-name supervisor] [--supervisor /usr/local/bin/supervisor]
#
# Each client first runs `supervisor keygen` and sends you their PUBLIC key hex.
set -euo pipefail

OUT="" HOST="" ROSTER="" PORT="9000" BIND="0.0.0.0" IP="" UNIT="supervisor"
SUP="$(command -v supervisor || echo /usr/local/bin/supervisor)"
KEYS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2;;
    --host) HOST="$2"; shift 2;;
    --roster) ROSTER="$2"; shift 2;;
    --authorized-key) KEYS+=("$2"); shift 2;;
    --port) PORT="$2"; shift 2;;
    --bind) BIND="$2"; shift 2;;
    --ip) IP="$2"; shift 2;;
    --unit-name) UNIT="$2"; shift 2;;
    --supervisor) SUP="$2"; shift 2;;
    -h|--help) sed -n '2,30p' "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

[ -n "$OUT" ]    || { echo "--out required" >&2; exit 2; }
[ -n "$HOST" ]   || { echo "--host required" >&2; exit 2; }
[ -n "$ROSTER" ] || { echo "--roster required" >&2; exit 2; }
[ "${#KEYS[@]}" -ge 1 ] || { echo "at least one --authorized-key required" >&2; exit 2; }
[ -f "$ROSTER" ] || { echo "roster not found: $ROSTER" >&2; exit 2; }
command -v openssl >/dev/null || { echo "openssl not found (try: nix shell nixpkgs#openssl -c $0 ...)" >&2; exit 2; }

mkdir -p "$OUT"
CERT="$OUT/server-cert.pem"
KEY="$OUT/server-key.pem"

# Self-signed ECDSA P-256 cert. SAN covers the host (and IP if given) though the client
# pins by exact cert (known-hosts) rather than name — SAN is belt-and-suspenders.
SAN="DNS:$HOST"
[ -n "$IP" ] && SAN="$SAN,IP:$IP"
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -keyout "$KEY" -out "$CERT" -days 3650 -nodes \
    -subj "/CN=$HOST" -addext "subjectAltName=$SAN" >/dev/null 2>&1
  chmod 600 "$KEY"
  echo "generated server cert: $CERT (distribute this to clients to pin)"
  echo "generated server key : $KEY (chmod 600; keep on this box only)"
else
  echo "server cert/key already exist in $OUT — reusing (delete to regenerate)"
fi

# Assemble the authorized-key flags.
KEY_ARGS=()
for k in "${KEYS[@]}"; do KEY_ARGS+=(--authorized-key "$k"); done

# Emit the run command.
RUN="$OUT/run.sh"
{
  echo "#!/usr/bin/env bash"
  echo "# Runs the authenticated supervisor. Generated by supervisor-bootstrap."
  echo "exec \"$SUP\" spawn \"$ROSTER\" \\"
  echo "  --control-port $PORT --control-bind $BIND \\"
  echo "  --tls-cert \"$CERT\" --tls-key \"$KEY\" \\"
  printf '  '; for k in "${KEYS[@]}"; do printf -- '--authorized-key %s ' "$k"; done; echo "\\"
  echo "  --logs warn"
} > "$RUN"
chmod +x "$RUN"
echo "wrote run script: $RUN"

# Emit a systemd unit.
UNIT_FILE="$OUT/$UNIT.service"
cat > "$UNIT_FILE" <<UNIT_EOF
[Unit]
Description=supervisor ($UNIT) — authenticated reconciler + host for the supervised tree
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$RUN
Restart=always
RestartSec=2
# NOTE: systemd stop/restart sends SIGTERM → the supervisor hard-kills the whole tree,
# then respawns on restart (correct for wedge remediation; not a graceful drain — see
# supervisor task #15). Point any liveness watchdog at THIS unit.

[Install]
WantedBy=multi-user.target
UNIT_EOF
echo "wrote systemd unit: $UNIT_FILE"

cat <<DONE

next:
  1. install the unit:   cp "$UNIT_FILE" /etc/systemd/system/ && systemctl daemon-reload
  2. start it:           systemctl enable --now $UNIT
  3. distribute the cert: send $CERT to each authorized client; they set
       server_cert = "<path-to-server-cert.pem>" in their ~/.config/supervisor/config profile
       (host = $HOST, port = $PORT, identity = their private key from \`supervisor keygen\`).
  4. verify remotely:    supervisor list --profile <name>

authorized keys seeded (${#KEYS[@]}):
$(for k in "${KEYS[@]}"; do echo "  - $k"; done)
DONE
